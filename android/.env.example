# GEMINI_API_KEY: Required for Gemini AI Advisor and Hinglish voice/text queries.
# Configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# CUELINKS_API_KEY: Cuelinks Pub API v3 token for automated affiliate link monetization.
CUELINKS_API_KEY=MY_CUELINKS_API_KEY

# BACKEND_URL: Optional external Node.js / Supabase proxy endpoint
BACKEND_URL=https://api.cuelinks.com
